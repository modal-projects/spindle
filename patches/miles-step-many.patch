+def _reduced_slot_norms(grads_by_slot: Sequence[Sequence[torch.Tensor]]) -> list[float]:
+    """World L2 norm of every slot's gradients from one SUM all-reduce of the squared norms."""
+    device = torch.device("cuda", torch.cuda.current_device()) if torch.cuda.is_available() else torch.device("cpu")
+    squared = torch.zeros(len(grads_by_slot), dtype=torch.float32, device=device)
+    for index, grads in enumerate(grads_by_slot):
+        for grad in grads:
+            squared[index] += torch.norm(grad.detach().float(), 2) ** 2
+    if dist.is_available() and dist.is_initialized():
+        dist.all_reduce(squared, op=dist.ReduceOp.SUM)
+    return [value**0.5 for value in squared.tolist()]
+
