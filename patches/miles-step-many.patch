+++ b/tests/fast/backends/megatron_utils/test_step_many.py
@@ -0,0 +1,101 @@
+"""step_many steps every slot like sequential clip_and_step with one norm reduction."""
+
+import torch
+import torch.distributed as dist
+
+from miles.backends.megatron_utils.lora.optimizer import SlotOptimizer
+
+
+class _Child:
+    """Stands in for a Float16 child: one parameter, SGD step on the clipped gradient."""
+
+    def __init__(self, parameter):
+        self.parameter = parameter
+
+    def get_grads_for_grad_norm(self):
+        return [self.parameter.grad]
+
+    def get_parameters(self):
+        return [self.parameter]
+
+    def step_with_ready_grads(self):
+        self.parameter.data.sub_(self.lr * self.parameter.grad)
+        return True
+
+
+class _FakeSlotOptimizer(SlotOptimizer):
+    def __init__(self, parameters):
+        self._inner = type("Inner", (), {"chained_optimizers": [_Child(p) for p in parameters]})()
+
+    def apply_adam_params(self, adam_params):
+        for child in self._inner.chained_optimizers:
+            child.lr = adam_params["learning_rate"]
+
+    def prepare_grads(self):
+        pass
+
+    def zero_grads(self):
+        for child in self._inner.chained_optimizers:
+            child.parameter.grad = None
+
+
+def _slots(generator, count=3):
+    slots = []
+    for _ in range(count):
+        parameters = []
+        for shape in ((4, 3), (3,)):
+            parameter = torch.nn.Parameter(torch.randn(*shape, generator=generator))
+            parameter.grad = torch.randn(*shape, generator=generator) * 3
+            parameters.append(parameter)
+        slots.append(parameters)
+    return slots
+
+
+def _clone(slots):
+    cloned = []
+    for parameters in slots:
+        copies = []
+        for parameter in parameters:
+            copy = torch.nn.Parameter(parameter.detach().clone())
+            copy.grad = parameter.grad.clone()
+            copies.append(copy)
+        cloned.append(copies)
+    return cloned
+
+
+def test_step_many_matches_sequential_clip_and_step(monkeypatch):
+    reductions = []
+    monkeypatch.setattr(dist, "all_reduce", lambda tensor, **kwargs: reductions.append(tensor.shape))
+    monkeypatch.setattr(dist, "is_initialized", lambda: True)
+    adam = [{"learning_rate": 0.01 * (slot + 1), "grad_clip_norm": 0.5 + slot} for slot in range(3)]
+
+    sequential = _clone(slots := _slots(torch.Generator().manual_seed(0)))
+    for parameters, params in zip(sequential, adam, strict=True):
+        optimizer = _FakeSlotOptimizer(parameters)
+        optimizer.apply_adam_params(params)
+        optimizer.prepare_grads()
+        optimizer.clip_and_step(params["grad_clip_norm"])
+        optimizer.zero_grads()
+    sequential_reductions = len(reductions)
+    reductions.clear()
+
+    batched = [_FakeSlotOptimizer(parameters) for parameters in slots]
+    outcomes = SlotOptimizer.step_many(list(zip(batched, adam, strict=True)))
+
+    assert sequential_reductions == 3 and reductions == [torch.Size([3])]
+    assert [outcome.keys() for outcome in outcomes] == [{"grad_norm"}] * 3
+    for expected, actual in zip(sequential, slots, strict=True):
+        for expected_parameter, actual_parameter in zip(expected, actual, strict=True):
+            assert torch.equal(expected_parameter, actual_parameter)
+            assert actual_parameter.grad is None
+
+
+def test_step_many_skips_a_nonfinite_slot_only(monkeypatch):
+    monkeypatch.setattr(dist, "is_initialized", lambda: False)
+    slots = _slots(torch.Generator().manual_seed(1), count=2)
+    slots[0][0].grad[0, 0] = float("nan")
+    before = _clone(slots)
+    adam = [{"learning_rate": 0.1, "grad_clip_norm": 0.0}] * 2
+    outcomes = SlotOptimizer.step_many(list(zip([_FakeSlotOptimizer(p) for p in slots], adam, strict=True)))
+    assert outcomes[0] == {"skipped_nonfinite": 1.0} and "grad_norm" in outcomes[1]
+    assert torch.equal(slots[0][0], before[0][0]) and not torch.equal(slots[1][0], before[1][0])
